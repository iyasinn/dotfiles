# Core setup
brew "git"   # Version control system
brew "stow"  # Symlink manager for dotfiles
brew "mise"  # Runtime/tool version manager, e.g. node/python/go/rust

# Shell / terminal basics
brew "zsh"      # Z shell
brew "fzf"      # Fuzzy finder for files/history/etc.
brew "ripgrep"  # Fast text search, `rg`
brew "fd"       # Fast file finder, nicer `find`
brew "eza"      # Modern `ls` replacement
brew "bat"      # `cat` replacement with syntax highlighting
brew "jq"       # JSON parser/formatter

# Terminal workflow
brew "neovim"   # Text editor
brew "tmux"     # Terminal multiplexer/sessions
brew "yazi"     # Terminal file manager
brew "lazygit"  # Terminal UI for Git

# macOS apps
cask "ghostty"             # Terminal emulator
cask "raycast"             # Launcher/productivity app
cask "karabiner-elements"  # Keyboard remapping
